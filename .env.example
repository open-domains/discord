DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-client-id
# Optional: set to register guild-specific commands during development
GUILD_ID=your-guild-id

# MongoDB connection string and database name
MONGO_URI=your-mongodb-uri
MONGO_DB_NAME=open_domains_bot

# Open Domains public API
# Optionally override API endpoints if they differ from defaults
# OPEN_DOMAINS_API_BASE=https://api.open-domains.net
# OPEN_DOMAINS_DEVICE_AUTH_PATH=/deviceAuth
# OPEN_DOMAINS_PUBLIC_API_PATH=/
# Enable mock device auth responses for local testing without calling the API
# OPEN_DOMAINS_MOCK_DEVICE_AUTH=true
